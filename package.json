{
  "name": "seamscript",
  "version": "0.4.0",
  "description": "A controlled language and runtime for baseball sequence analysis.",
  "type": "module",
  "bin": {
    "seam": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "web",
    "data/sample-pitches.csv",
    "examples",
    "docs",
    "LANGUAGE_SPEC.md",
    "PITCH.md",
    "TARGET_USERS.md",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run test",
    "data:generate": "tsx scripts/generate-demo-data.ts",
    "model:evaluate": "tsx scripts/evaluate-demo-model.ts",
    "dev": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts run examples/decision.seam --catalog examples/demo.catalog.yml",
    "demo:sequence": "tsx src/cli.ts run examples/demo.seam --catalog examples/demo.catalog.yml",
    "demo:record": "tsx scripts/record-demo.ts",
    "app": "tsx src/server.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run format:check && npm run check && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "csv-parse": "^7.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
